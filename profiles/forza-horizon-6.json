{
  "id": "forza-horizon-6",
  "settingsFingerprintKeys": [
    {
      "label": "dlssMode",
      "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
      "pattern": "<option id=\"DLSSMode\" value=\"(\\d+)\"",
      "valueMap": {
        "0": "Off",
        "1": "On"
      }
    },
    {
      "label": "fsr3Mode",
      "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
      "pattern": "<option id=\"FSR3Mode\" value=\"(\\d+)\"",
      "valueMap": {
        "0": "Off"
      }
    },
    {
      "label": "taa",
      "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
      "pattern": "<option id=\"TAA\" value=\"(\\d+)\"",
      "valueMap": {
        "0": "Off",
        "1": "On"
      }
    },
    {
      "label": "resScaling",
      "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
      "pattern": "<option id=\"ResolutionScaling\" value=\"(\\d+)\""
    },
    {
      "label": "rtReflection",
      "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
      "pattern": "<option id=\"RTReflectionQuality\" value=\"(\\d+)\""
    },
    {
      "label": "rtgi",
      "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
      "pattern": "<option id=\"RTGIQuality\" value=\"(\\d+)\""
    },
    {
      "label": "frameGen",
      "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
      "pattern": "<option id=\"DLSSGMode\" value=\"(\\d+)\"",
      "isFrameGen": true,
      "frameGenOffValues": [
        "0"
      ]
    }
  ],
  "name": "Forza Horizon 6",
  "engine": "ForzaTech",
  "enabled": true,
  "repeats": 3,
  "supportedResolutions": [
    "1080p",
    "1440p",
    "4K"
  ],
  "graphicsPreset": "Extreme",
  "variants": [
    {
      "id": "as-set",
      "name": "As configured in-game",
      "enabled": true,
      "settings": {}
    },
    {
      "id": "dlss-auto",
      "name": "NVIDIA DLSS (Super Resolution Auto)",
      "enabled": false,
      "settings": {
        "dlssMode": "On",
        "taa": "Off",
        "resolutionScaling": "Off"
      }
    }
  ],
  "settings": [
    {
      "key": "dlssMode",
      "label": "NVIDIA DLSS",
      "options": [
        "Off",
        "On"
      ],
      "default": "",
      "apply": {
        "method": "config-file",
        "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
        "valueMap": {
          "Off": "0",
          "On": "1"
        },
        "edits": [
          {
            "pattern": "(<option id=\"DLSSMode\" value=\")\\d+",
            "replacement": "${1}{VALUE}"
          }
        ]
      }
    },
    {
      "key": "taa",
      "label": "TAA",
      "options": [
        "Off",
        "On"
      ],
      "default": "",
      "apply": {
        "method": "config-file",
        "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
        "valueMap": {
          "Off": "0",
          "On": "1"
        },
        "edits": [
          {
            "pattern": "(<option id=\"TAA\" value=\")\\d+",
            "replacement": "${1}{VALUE}"
          }
        ]
      }
    },
    {
      "key": "resolutionScaling",
      "label": "Resolution Scaling",
      "options": [
        "Off",
        "On"
      ],
      "default": "",
      "apply": {
        "method": "config-file",
        "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
        "valueMap": {
          "Off": "0",
          "On": "1"
        },
        "edits": [
          {
            "pattern": "(<option id=\"ResolutionScaling\" value=\")\\d+",
            "replacement": "${1}{VALUE}"
          }
        ]
      }
    }
  ],
  "captureProcessName": "forzahorizon6.exe",
  "frameProvider": "rtss",
  "startupGraceSeconds": 240,
  "launch": {
    "store": "Xbox",
    "gameId": "Microsoft.ForteBaseGame_8wekyb3d8bbwe!Forzahorizon6"
  },
  "resolutionApply": {
    "method": "config-file",
    "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
    "edits": [
      {
        "pattern": "<ResolutionWidth value=\"\\d+\"/>",
        "replacement": "<ResolutionWidth value=\"{WIDTH}\"/>"
      },
      {
        "pattern": "<ResolutionHeight value=\"\\d+\"/>",
        "replacement": "<ResolutionHeight value=\"{HEIGHT}\"/>"
      },
      {
        "pattern": "<Fullscreen value=\"\\d+\"/>",
        "replacement": "<Fullscreen value=\"1\"/>"
      },
      {
        "pattern": "<PresentInterval value=\"\\d+\"/>",
        "replacement": "<PresentInterval value=\"0\"/>"
      },
      {
        "pattern": "(<AllowScreenTearing[^/]*value=\")\\d+",
        "replacement": "${1}1"
      },
      {
        "pattern": "<option id=\"FrameRate\" value=\"\\d+\"/>",
        "replacement": "<option id=\"FrameRate\" value=\"4\"/>"
      },
      {
        "pattern": "<option id=\"VSync\" value=\"\\d+\"/>",
        "replacement": "<option id=\"VSync\" value=\"0\"/>"
      }
    ]
  },
  "settingsVerify": {
    "method": "config-file",
    "configFilePath": "${LOCAL_CONFIGURATION_PATH}",
    "expectedPattern": "<ResolutionWidth value=\"{WIDTH}\"/>"
  },
  "scenes": [
    {
      "id": "builtin-benchmark",
      "name": "Benchmark Mode (Settings > Graphics & Performance)",
      "kind": "BotDriven",
      "captureSeconds": 300,
      "warmupSeconds": 0,
      "readinessTimeoutSeconds": 300,
      "botScript": "forzahorizon6_benchmark_nav",
      "warmupRepeats": 1,
      "singleLaunchRepeats": true,
      "reRunBotScript": "forzahorizon6_rerun",
      "completion": {
        "method": "duration",
        "gameplayBandCeilingFps": 2000
      }
    }
  ]
}
                             ],
                    "controls":  [
                                     {
                                         "settingKey":  "rt",
                                         "label":  "Raytracing quality",
                                         "rowValueLabel":  "Raytracing quality",
                                         "actuation":  "cycle",
                                         "cycleRight":  "Right",
                                         "cycleLeft":  "Left",

                                         "optionOrder":  [
                                                             "Auto",
                                                             "Off",
                                                             "CarReflections",
                                                             "CarReflectionsRtao",
                                                             "FullReflectionsRtao",
                                                             "FullReflectionsRtgi"
                                                         ],
                                         "optionLabels":  {
                                                              "Auto":  "Auto",
                                                              "Off":  "Off",
                                                              "CarReflections":  "Car reflections",
                                                              "CarReflectionsRtao":  "Car reflections + RTAO",
                                                              "FullReflectionsRtao":  "Full reflections + RTAO",
                                                              "FullReflectionsRtgi":  "Full reflections + RTGI"
                                                          }
                                     }
                                 ]
                },
    "captureProcessName":  "forza_gaming.desktop.x64_release_final.exe",
    "frameProvider":  "rtss",
    "startupGraceSeconds":  240,
    "launch":  {
                   "store":  "Xbox",
                   "gameId":  "Microsoft.ForzaMotorsport_8wekyb3d8bbwe!ReleaseFinal"
               },
    "resolutionApply":  {
                            "method":  "config-file",
                            "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                            "switchDesktopMode":  true,
                            "fingerprintWidthLabel":  "outputW",
                            "fingerprintHeightLabel":  "outputH",
                            "edits":  [
                                          {
                                              "pattern":  "(\u003coption id=\"IDS_Resolution_Label\" value=\")[^\"]+",
                                              "replacement":  "${1}{WIDTH}x{HEIGHT}"
                                          }
                                      ]
                        },
    "settingsVerify":  {
                           "method":  "none"
                       },
    "scenes":  [
                   {
                       "id":  "builtin-benchmark",

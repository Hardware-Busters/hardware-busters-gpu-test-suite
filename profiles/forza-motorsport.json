{
    "id":  "forza-motorsport",
    "settingsFingerprintKeys":  [
                                    {
                                        "label":  "dlssMode",
                                        "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                                        "pattern":  "\u003coption id=\"IDS_DLSSMode_Label\" value=\"([^\"]+)\""
                                    },
                                    {
                                        "label":  "taa",
                                        "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                                        "pattern":  "\u003coption id=\"IDS_TAA_Label\" value=\"([^\"]+)\""
                                    },
                                    {
                                        "label":  "resScale",
                                        "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                                        "pattern":  "\u003coption id=\"IDS_ResolutionScale_Label\" value=\"([^\"]+)\""
                                    },
                                    {
                                        "label":  "rayTracing",
                                        "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                                        "pattern":  "\u003coption id=\"IDS_RaytracingQuality_Label\" value=\"([^\"]+)\""
                                    },
                                    {
                                        "label":  "renderQuality",
                                        "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                                        "pattern":  "\u003coption id=\"IDS_DynamicRenderQuality_Label\" value=\"([^\"]+)\""
                                    },
                                    {
                                        "label":  "frameGen",
                                        "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                                        "pattern":  "\u003cDLSSGEnabled value=\"([\\d.]+)\"",
                                        "isFrameGen":  true,
                                        "frameGenOffValues":  [
                                                                  "0.000000",
                                                                  "0"
                                                              ]
                                    },
                                    {
                                        "label":  "outputW",
                                        "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                                        "pattern":  "\u003coption id=\"IDS_Resolution_Label\" value=\"(\\d+)x\\d+\""
                                    },
                                    {
                                        "label":  "outputH",
                                        "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                                        "pattern":  "\u003coption id=\"IDS_Resolution_Label\" value=\"\\d+x(\\d+)\""
                                    }
                                ],
    "name":  "Forza Motorsport",
    "engine":  "ForzaTech",
    "enabled":  true,
    "repeats":  3,
    "supportedResolutions":  [
                                 "1080p",
                                 "1440p",
                                 "4K"
                             ],
    "graphicsPreset":  "Ultra",
    "variants":  [
                     {
                         "id":  "as-set",
                         "name":  "Ultra (as configured in-game)",
                         "enabled":  true,
                         "settings":  {

                                      }
                     },
                     {
                         "id":  "dlss-q",
                         "name":  "DLSS Quality, FG off",
                         "enabled":  false,
                         "settings":  {
                                          "dlssMode":  "Quality",
                                          "frameGen":  "Off"
                                      }
                     },
                     {
                         "id":  "dlss-p",
                         "name":  "DLSS Performance, FG off (pinned as-set)",
                         "enabled":  false,
                         "settings":  {
                                          "dlssMode":  "Performance",
                                          "frameGen":  "Off"
                                      }
                     },
                     {
                         "id":  "native",
                         "name":  "Native (no upscaling), FG off",
                         "enabled":  false,
                         "settings":  {
                                          "dlssMode":  "Off",
                                          "frameGen":  "Off"
                                      }
                     },
                     {
                         "id":  "rt-full",
                         "name":  "RT Full reflections + RTGI",
                         "enabled":  false,
                         "settings":  {
                                          "rt":  "FullReflectionsRtgi"
                                      }
                     },
                     {
                         "id":  "rt-off",
                         "name":  "RT explicitly Off",
                         "enabled":  false,
                         "settings":  {
                                          "rt":  "Off"
                                      }
                     }
                 ],
    "settings":  [
                     {
                         "key":  "dlssMode",
                         "label":  "DLSS Mode (method + tier in one knob)",
                         "options":  [
                                         "Off",
                                         "Quality",
                                         "Performance"
                                     ],
                         "default":  "",
                         "apply":  {
                                       "method":  "config-file",
                                       "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                                       "valueMap":  {
                                                        "Off":  "IDS_Off",
                                                        "Quality":  "IDS_DLSS_Quality",
                                                        "Performance":  "IDS_DLSS_Performance"
                                                    },
                                       "edits":  [
                                                     {
                                                         "pattern":  "(\u003coption id=\"IDS_DLSSMode_Label\" value=\")[^\"]+",
                                                         "replacement":  "${1}{VALUE}"
                                                     }
                                                 ]
                                   }
                     },
                     {
                         "key":  "rt",
                         "label":  "Raytracing quality",
                         "options":  [
                                         "Auto",
                                         "Off",
                                         "CarReflections",
                                         "CarReflectionsRtao",
                                         "FullReflectionsRtao",
                                         "FullReflectionsRtgi"
                                     ],
                         "default":  "",
                         "apply":  {
                                       "method":  "config-file",
                                       "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                                       "valueMap":  {
                                                        "Off":  "IDS_Off",
                                                        "FullReflectionsRtgi":  "IDS_RaytracingFullReflectionsAndRTGI"
                                                    },
                                       "edits":  [
                                                     {
                                                         "pattern":  "(\u003coption id=\"IDS_RaytracingQuality_Label\" value=\")[^\"]+",
                                                         "replacement":  "${1}{VALUE}"
                                                     }
                                                 ],
                                       "verifyPattern":  "\u003coption id=\"IDS_RaytracingQuality_Label\" value=\"{VALUE}\""
                                   }
                     },
                     {
                         "key":  "frameGen",
                         "label":  "Frame Generation (DLSS-G)",
                         "options":  [
                                         "On",
                                         "Off"
                                     ],
                         "default":  "",
                         "apply":  {
                                       "method":  "config-file",
                                       "configFilePath":  "${LOCAL_CONFIGURATION_PATH}",
                                       "valueMap":  {
                                                        "On":  "1.000000",
                                                        "Off":  "0.000000"
                                                    },
                                       "edits":  [
                                                     {
                                                         "pattern":  "(\u003cDLSSGEnabled value=\")[\\d.]+",
                                                         "replacement":  "${1}{VALUE}"
                                                     }
                                                 ]
                                   }
                     }
                 ],
    "menuMap":  {
                    "inputDevice":  "keyboard",

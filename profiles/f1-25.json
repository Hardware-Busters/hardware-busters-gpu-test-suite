    },
    {
      "key": "pathTracing",
      "label": "Path Tracing",
      "options": [
        "On",
        "Off"
      ],
      "default": "",
      "apply": {
        "method": "config-file",
        "configFilePath": "%USERPROFILE%\\Documents\\My Games\\F1 25\\hardwaresettings\\hardware_settings_config.xml",
        "edits": [
          {
            "pattern": "(<rt_pathtrace\\s+enabled=\")[^\"]*(\")",
            "replacement": "${1}{VALUE}${2}",
            "valueMap": {
              "On": "true",
              "Off": "false"
            }
          }
        ]
      }
    }

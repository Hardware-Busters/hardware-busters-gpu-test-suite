{
  "id": "f1-25",
  "settingsFingerprintKeys": [
    {
      "label": "dlss",
      "configFilePath": "%USERPROFILE%\\Documents\\My Games\\F1 25\\hardwaresettings\\hardware_settings_config.xml",
      "pattern": "\\bdlss=\"(\\w+)\""
    },
    {
      "label": "aaQuality",
      "configFilePath": "%USERPROFILE%\\Documents\\My Games\\F1 25\\hardwaresettings\\hardware_settings_config.xml",
      "pattern": "<aa_quality value=\"(\\d+)\"",
      "valueMap": {
        "0": "Quality",
        "1": "Balanced",
        "2": "Performance",
        "3": "UltraPerformance",
        "4": "DLAA"
      }
    },
    {
      "label": "pathTracing",
      "configFilePath": "%USERPROFILE%\\Documents\\My Games\\F1 25\\hardwaresettings\\hardware_settings_config.xml",
      "pattern": "<rt_pathtrace enabled=\"(\\w+)\""
    },
    {
      "label": "multiFrameGen",
      "configFilePath": "%USERPROFILE%\\Documents\\My Games\\F1 25\\hardwaresettings\\hardware_settings_config.xml",
      "pattern": "<multi_frame_gen value=\"(\\d+)\""
    },
    {
      "label": "frameGen",
      "configFilePath": "%USERPROFILE%\\Documents\\My Games\\F1 25\\hardwaresettings\\hardware_settings_config.xml",
      "pattern": "<frame_gen mode=\"(\\d+)\"",
      "isFrameGen": true,
      "frameGenOffValues": [
        "0"
      ]
    }
  ],
  "name": "F1 25",
  "engine": "EGO Engine (Codemasters)",
  "enabled": true,
  "repeats": 3,
  "frameProvider": "presentmon",
  "startupGraceSeconds": 240,
  "supportedResolutions": [
    "1080p",
    "1440p",
    "4K"
  ],
  "graphicsPreset": "Ultra High",
  "settings": [
    {
      "key": "upscaler",
      "label": "Anti-Aliasing / Upscaling",
      "options": [
        "Off",
        "DLSS",
        "FSR",
        "XeSS"
      ],
      "default": "DLSS",
      "apply": {
        "method": "config-file",
        "configFilePath": "%USERPROFILE%\\Documents\\My Games\\F1 25\\hardwaresettings\\hardware_settings_config.xml",
        "edits": [
          {
            "pattern": "(\\btaa=\")[^\"]*(\")",
            "replacement": "${1}{VALUE}${2}",
            "valueMap": {
              "Off": "true",
              "DLSS": "false",
              "FSR": "false",
              "XeSS": "false"
            }
          },
          {
            "pattern": "(\\bdlss=\")[^\"]*(\")",
            "replacement": "${1}{VALUE}${2}",
            "valueMap": {
              "Off": "false",
              "DLSS": "true",
              "FSR": "false",
              "XeSS": "false"
            }
          },
          {
            "pattern": "(\\bfsr3=\")\\d+(\")",
            "replacement": "${1}{VALUE}${2}",
            "valueMap": {
              "Off": "0",
              "DLSS": "0",
              "FSR": "1",
              "XeSS": "0"
            }
          },
          {
            "pattern": "(\\bxess=\")[^\"]*(\")",
            "replacement": "${1}{VALUE}${2}",
            "valueMap": {
              "Off": "false",
              "DLSS": "false",
              "FSR": "false",
              "XeSS": "true"
            }
          }
        ]
      }
    },
    {
      "key": "upscalerQuality",
      "label": "Upscaler Quality",
      "options": [
        "Quality",
        "Balanced",
        "Performance",
        "UltraPerformance",
        "DLAA"
      ],
      "default": "Quality",
      "apply": {
        "method": "config-file",
        "configFilePath": "%USERPROFILE%\\Documents\\My Games\\F1 25\\hardwaresettings\\hardware_settings_config.xml",
        "edits": [
          {
            "pattern": "(<aa_quality\\s+value=\")\\d+(\")",
            "replacement": "${1}{VALUE}${2}",
            "valueMap": {
              "Quality": "0",
              "Balanced": "1",
              "Performance": "2",
              "UltraPerformance": "3",
              "DLAA": "4"
            }
          }
        ]
      }
    },
    {

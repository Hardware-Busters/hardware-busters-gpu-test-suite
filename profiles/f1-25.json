      "default": "On",
      "apply": {
        "method": "config-file",
        "configFilePath": "%USERPROFILE%\\Documents\\My Games\\F1 25\\hardwaresettings\\hardware_settings_config.xml",
        "edits": [
          {
            "pattern": "(<rt_shadows\\s+enabled=\")[^\"]*(\")",
            "replacement": "${1}{VALUE}${2}",
            "valueMap": {
              "On": "true",
              "Off": "false"
            }
          },
          {
            "pattern": "(<rt_reflections\\s+enabled=\")[^\"]*(\")",
            "replacement": "${1}{VALUE}${2}",
            "valueMap": {
              "On": "true",
              "Off": "false"
            }
          },
          {
            "pattern": "(<rt_transparent_reflections\\s+enabled=\")[^\"]*(\")",
            "replacement": "${1}{VALUE}${2}",
            "valueMap": {
              "On": "true",
              "Off": "false"
            }
          },
          {
            "pattern": "(<rt_ao\\s+enabled=\")[^\"]*(\")",
            "replacement": "${1}{VALUE}${2}",
            "valueMap": {
              "On": "true",
              "Off": "false"
            }
          },
          {
            "pattern": "(<rt_ddgi\\s+enabled=\")[^\"]*(\")",
            "replacement": "${1}{VALUE}${2}",
            "valueMap": {
              "On": "true",
              "Off": "false"
            }

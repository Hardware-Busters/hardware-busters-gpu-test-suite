<Application x:Class="GpuSuite.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GpuSuite.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
            <conv:CheckStatusToBrushConverter x:Key="CheckStatusToBrush"/>
            <conv:CheckStatusToGlyphConverter x:Key="CheckStatusToGlyph"/>
            <conv:DictionaryToStringConverter x:Key="DictToString"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<UserControl x:Class="GpuSuite.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GpuSuite.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ResultsViewModel}"
             Background="Transparent">

    <Grid Margin="28,24,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Master: result sets ===== -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <Grid>
                    <TextBlock Text="Results" Style="{StaticResource H1TextStyle}"/>
                    <Button Content="Refresh" Style="{StaticResource LinkButtonStyle}" Command="{Binding LoadCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                <TextBlock Text="Loading results…" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,4,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <ListBox Grid.Row="1" Style="{StaticResource RowsListBoxStyle}" ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult, Mode=TwoWay}" ItemContainerStyle="{StaticResource GameRowItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Result.GpuName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Result.GeneratedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm} UTC'}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Result.OverallPerformanceIndex, StringFormat='index {0:0.0}'}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="  ·  " Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Result.Aggregates.Count, StringFormat='{}{0} aggregates'}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ===== Detail ===== -->
        <Grid Grid.Column="1">
            <!-- Placeholder when nothing selected / empty -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedResult}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="No results yet" Style="{StaticResource H2TextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Run a sweep (on the bench) to produce a report; saved runs appear here."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Selected result detail -->
            <Grid Visibility="{Binding SelectedResult, Converter={StaticResource NullToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- System info + actions -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedResult.Result.GpuName}" Style="{StaticResource H2TextStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding SelectedResult.Result.System.CpuName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="  ·  " Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedResult.Result.System.SuiteVersion, StringFormat='suite {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="  ·  " Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedResult.Result.OverallPerformanceIndex, StringFormat='index {0:0.0}'}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"/>
                            <Button Content="Open HTML report" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenReportCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cross-run comparison: same game/scene/resolution/model cells only. -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="COMPARE RUNS" Style="{StaticResource LabelTextStyle}" Margin="0"/>
                            <TextBlock Text="{Binding ComparisonSummary}" HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,7,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Results}" SelectedItem="{Binding ComparisonBaseline, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayLabel" ToolTip="Baseline result set."/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Results}" SelectedItem="{Binding ComparisonTarget, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayLabel" ToolTip="Target result set; deltas show target versus baseline."/>
                        </Grid>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ComparisonRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding BaselineFps, StringFormat='{}{0:0.0} fps'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TargetFps, StringFormat='{}{0:0.0} fps'}" FontSize="11"/>
                                            <TextBlock Grid.Column="3" Text="{Binding FpsDeltaPct, StringFormat='{}{0:+0.0;-0.0;0.0}% FPS'}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding LowDeltaPct, StringFormat='{}{0:+0.0;-0.0;0.0}% low'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding EfficiencyDeltaPct, StringFormat='{}{0:+0.0;-0.0;0.0}% eff'}" ToolTip="{Binding PowerComparisonReason}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Aggregates table -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="GAME" Style="{StaticResource LabelTextStyle}" Margin="0"/>
                                <TextBlock Grid.Column="1" Text="RES" Style="{StaticResource LabelTextStyle}" Margin="0"/>
                                <TextBlock Grid.Column="2" Text="MODEL" Style="{StaticResource LabelTextStyle}" Margin="0"/>
                                <TextBlock Grid.Column="3" Text="AVG FPS" Style="{StaticResource LabelTextStyle}" Margin="0"/>
                                <TextBlock Grid.Column="4" Text="1% LOW" Style="{StaticResource LabelTextStyle}" Margin="0"/>
                                <TextBlock Grid.Column="5" Text="GPU W" Style="{StaticResource LabelTextStyle}" Margin="0"/>
                                <TextBlock Grid.Column="6" Text="FPS/W" Style="{StaticResource LabelTextStyle}" Margin="0"/>
                                <TextBlock Grid.Column="7" Text="VALID" Style="{StaticResource LabelTextStyle}" Margin="0"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SelectedResult.Result.Aggregates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="75"/>
                                                    <ColumnDefinition Width="75"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding GameId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ResolutionName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                <TextBlock Grid.Column="2" Text="{Binding VariantName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding AvgFps, StringFormat='{}{0:0.0}'}" FontSize="12"/>
                                                <TextBlock Grid.Column="4" Text="{Binding P1LowFps, StringFormat='{}{0:0.0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                <StackPanel Grid.Column="5">
                                                    <TextBlock Text="{Binding AvgGpuPowerW, StringFormat='{}{0:0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                    <TextBlock Text="{Binding PowerMeasurement.DisplayLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="6" Text="{Binding FpsPerWatt, StringFormat='{}{0:0.00}', TargetNullValue=—}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                <TextBlock Grid.Column="7" Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}/{1}">
                                                            <Binding Path="ValidRuns"/>
                                                            <Binding Path="TotalRuns"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="GpuSuite.App.Views.GameListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GpuSuite.App.ViewModels"
             xmlns:views="clr-namespace:GpuSuite.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GameListViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:GameDetailViewModel}">
            <views:GameDetailView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" MinWidth="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Master: the list ===== -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <Grid>
                    <TextBlock Text="Benchmark List" Style="{StaticResource H1TextStyle}"/>
                    <Button Content="Reload" Style="{StaticResource LinkButtonStyle}" Command="{Binding LoadCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                <CheckBox Content="Show disabled/internal profiles" IsChecked="{Binding ShowDisabled, Mode=TwoWay}"
                          Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,7,0,0"
                          ToolTip="Reveal attach-only, synthetic, template, and other disabled profiles without enabling them."/>
                <TextBlock Text="Resolving installed games…" Foreground="{StaticResource AccentBrush}" FontSize="12"
                           Margin="0,4,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <ListBox Grid.Row="1" Style="{StaticResource RowsListBoxStyle}"
                     ItemsSource="{Binding Games}"
                     SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource GameRowItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameRowViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0"
                                             Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                    <TextBlock Text="  ·  " Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding StoreLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="  ·  " Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SceneCount, StringFormat={}{0} scenes}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="  ·  " Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ModelCount, StringFormat={}{0} models}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                      Margin="12,0,0,0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      ToolTip="Enable/disable in the benchmark list (saved immediately)"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ===== Detail ===== -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding SelectedDetail}"/>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedDetail}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Select a game" Style="{StaticResource H2TextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Pick a profile on the left to see its launch, scenes, settings and models."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

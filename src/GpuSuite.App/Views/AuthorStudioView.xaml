                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="RECORDED ROUTES" Style="{StaticResource LabelTextStyle}"/><ListBox ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}" DisplayMemberPath="RelativePath" Height="260"/><TextBox Margin="0,8,0,0" Text="{Binding NewRoutePath}"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button Content="Create" Command="{Binding CreateRouteCommand}"/><Button Content="Import…" Command="{Binding ImportRouteCommand}" Margin="6,0,0,0"/></StackPanel><TextBox Margin="0,12,0,0" Text="{Binding DuplicateRoutePath}"/><Button Content="Duplicate selected" Command="{Binding DuplicateRouteCommand}" Margin="0,5,0,0"/><Button Content="Delete selected" Command="{Binding DeleteRouteCommand}" Margin="0,5,0,0"/><TextBlock Text="Discovery recording is configured by a SmartTraverse or Gx10Traverse bot action's Record path. Import the generated JSON here; Author Studio itself never injects game input." TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,0"/></StackPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding SelectedRoute}"><TextBlock Text="ROUTE EDITOR &amp; PREVIEW" Style="{StaticResource H2TextStyle}"/><TextBlock Text="{Binding DataContext.RoutePreview, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Pack path"/><TextBox Grid.Column="1" Text="{Binding DataContext.RouteEditPath, RelativeSource={RelativeSource AncestorType=UserControl}}"/><TextBlock Grid.Column="2" Text="Recorded device"/><TextBox Grid.Column="3" Text="{Binding Route.RecordedDevice, UpdateSourceTrigger=PropertyChanged}"/></Grid><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Version"/><TextBox Grid.Column="1" Text="{Binding Route.Version, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="Note"/><TextBox Grid.Column="3" Text="{Binding Route.Note, UpdateSourceTrigger=PropertyChanged}"/></Grid><StackPanel Orientation="Horizontal" Margin="0,12,0,5"><Button Content="Add step" Command="{Binding DataContext.AddRouteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Remove" Command="{Binding DataContext.DeleteRouteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="6,0"/><Button Content="↑" Command="{Binding DataContext.MoveRouteStepUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="↓" Command="{Binding DataContext.MoveRouteStepDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/></StackPanel><DataGrid ItemsSource="{Binding DataContext.RouteSteps, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedRouteStep, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="360"><DataGrid.Columns><DataGridTemplateColumn Header="Primitive" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kind}"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.RouteStepKinds, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Duration ms" Binding="{Binding DurationMs, UpdateSourceTrigger=PropertyChanged}" Width="120"/><DataGridTextColumn Header="Turn degrees" Binding="{Binding Deg, UpdateSourceTrigger=PropertyChanged}" Width="120"/></DataGrid.Columns></DataGrid><Button Content="Save route" Command="{Binding DataContext.SaveRouteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Templates &amp; assets" IsEnabled="{Binding HasDraft}">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,6,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="TEXT TEMPLATES" Style="{StaticResource H2TextStyle}"/><ListBox Grid.Row="1" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="RelativePath" Margin="0,6"/><StackPanel Grid.Row="2"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Create" Command="{Binding CreateTemplateCommand}"/><Button Content="Import…" Command="{Binding ImportTemplateCommand}" Margin="6,0,0,0"/></StackPanel><TextBox Text="{Binding NewTemplatePath}"/></DockPanel><DockPanel Margin="0,5,0,0"><Button DockPanel.Dock="Right" Content="Delete" Command="{Binding DeleteTemplateCommand}" Margin="6,0,0,0"/><TextBox Text="{Binding TemplateEditPath}" ToolTip="Rename within templates"/></DockPanel></StackPanel><TextBox Grid.Row="3" Text="{Binding TemplateText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,8"/><Button Grid.Row="4" Content="Save template" Command="{Binding SaveTemplateCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/></Grid></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="BINARY / DOCUMENTATION ASSETS" Style="{StaticResource H2TextStyle}"/><ListBox ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" DisplayMemberPath="RelativePath" Height="230" Margin="0,6"/><TextBlock Text="{Binding AssetPreview}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10"/><DockPanel><Button DockPanel.Dock="Right" Content="Import…" Command="{Binding ImportAssetCommand}"/><TextBox Text="{Binding NewAssetPath}" ToolTip="Destination inside assets"/></DockPanel><DockPanel Margin="0,6,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Rename" Command="{Binding RenameAssetCommand}"/><Button Content="Delete" Command="{Binding DeleteAssetCommand}" Margin="6,0,0,0"/></StackPanel><TextBox Text="{Binding AssetEditPath}" ToolTip="Rename inside assets"/></DockPanel><TextBlock Text="Imports are copied into the draft with a 16 MiB limit. Executable pack content remains prohibited by validation." TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,0"/></StackPanel></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Inventory &amp; problems"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="INVENTORY" Style="{StaticResource LabelTextStyle}"/><TextBlock Text="{Binding InventorySummary}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8"/><ListBox ItemsSource="{Binding Inventory}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="PROBLEMS" Style="{StaticResource LabelTextStyle}"/><ItemsControl ItemsSource="{Binding Problems}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid></TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="7" Padding="12,8" Margin="0,12,0,0"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></Border>
    </Grid>
</UserControl>

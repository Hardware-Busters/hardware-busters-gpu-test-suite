<UserControl x:Class="GpuSuite.App.Views.AuthorStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GpuSuite.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AuthorStudioViewModel}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Author Studio" Style="{StaticResource H1TextStyle}"/>
                <TextBlock Text="Complete visual pack, profile, bot, navigation-graph, route, template, and asset authoring. Installed packs remain clone-only."
                           Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="New to pack authoring? Press F1 here, or select ? in the title bar, for the complete step-by-step guide."
                           Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Undo" Command="{Binding UndoAdvancedCommand}" Margin="0,0,6,0"/>
                <Button Content="Redo" Command="{Binding RedoAdvancedCommand}" Margin="0,0,12,0"/>
                <Button Content="Open draft…" Command="{Binding OpenCommand}" Margin="0,0,8,0"/>
                <Button Content="Clone pack…" Command="{Binding CloneCommand}" Margin="0,0,8,0"/>
                <Button Content="Create draft…" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="1" Margin="0,16,0,0" IsEnabled="{Binding IsEditorEnabled}" SelectedIndex="{Binding AuthorTabIndex}">
            <TabItem Header="Pack">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="NEW DRAFT DEFAULTS" Style="{StaticResource LabelTextStyle}"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Pack id" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding NewPackId, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Pack name" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding NewPackName, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}"><StackPanel>
                        <TextBlock Text="PACK METADATA" Style="{StaticResource LabelTextStyle}"/><TextBlock Text="{Binding DraftPath}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,10" TextTrimming="CharacterEllipsis"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Id" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding PackId, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Name" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding PackName, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Version" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding PackVersion, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Publisher" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="License / homepage" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBox Text="{Binding License, UpdateSourceTrigger=PropertyChanged}"/><TextBox Margin="0,5,0,0" Text="{Binding Homepage, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Minimum engine" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding MinimumEngineVersion, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Description" VerticalAlignment="Top"/><TextBox Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="54" TextWrapping="Wrap"/></Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Save metadata" Command="{Binding SaveCommand}" Margin="0,0,8,0"/><Button Content="Validate" Command="{Binding ValidateCommand}" Margin="0,0,8,0"/><Button Content="Export .gtsprofilepack…" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Profiles" IsEnabled="{Binding HasDraft}">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="DRAFT PROFILES" Style="{StaticResource LabelTextStyle}"/><ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Profile.Name" Height="260"/>
                        <TextBox Margin="0,10,0,0" Text="{Binding NewProfileId, UpdateSourceTrigger=PropertyChanged}" ToolTip="New profile id"/><TextBox Margin="0,5,0,0" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="New profile name"/><Button Content="Create profile" Command="{Binding CreateProfileCommand}" Margin="0,5,0,0"/>
                        <TextBox Margin="0,14,0,0" Text="{Binding DuplicateProfileId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Duplicate profile id"/><Button Content="Duplicate selected" Command="{Binding DuplicateProfileCommand}" Margin="0,5,0,0"/><Button Content="Delete selected" Command="{Binding DeleteProfileCommand}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding SelectedProfile}">
                        <TextBlock Text="PROFILE FORM" Style="{StaticResource H2TextStyle}"/><TextBlock Text="Changes are saved only to this draft; profile id save also renames the draft file." Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,12"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Id" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Profile.Id, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="Name" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Profile.Name, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox Content="Enabled" IsChecked="{Binding Profile.Enabled}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Capture process" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Profile.CaptureProcessName, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Store" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Profile.Launch.Store, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="Game / target" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Profile.Launch.GameId, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Arguments" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Profile.Launch.Arguments, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="Frame provider" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Profile.FrameProvider, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Standalone target" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Profile.Launch.Target, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="Working directory" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Profile.Launch.WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Repeats" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Profile.Repeats, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="Startup grace (s)" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Profile.StartupGraceSeconds, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Resolution method" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Profile.ResolutionApply.Method, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="Verified fixed res" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Profile.ResolutionApply.VerifiedFixedResolution, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Settings bot" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.BotIds, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Profile.SettingsBotScript}" IsEditable="True"/></Grid>
                        <Border Background="{StaticResource SurfaceAltBrush}" Padding="10" Margin="0,8,0,0"><StackPanel>
                            <TextBlock Text="RESOLUTION APPLY DETAILS" Style="{StaticResource LabelTextStyle}"/>
                            <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Config path"/><TextBox Grid.Column="1" Text="{Binding Profile.ResolutionApply.ConfigFilePath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="Registry key"/><TextBox Grid.Column="3" Text="{Binding Profile.ResolutionApply.RegistryKey, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                            <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Template path"/><TextBox Grid.Column="1" Text="{Binding Profile.ResolutionApply.TemplateFilePath, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Grid.Column="2" Grid.ColumnSpan="2" Content="Switch desktop mode" IsChecked="{Binding Profile.ResolutionApply.SwitchDesktopMode}"/></Grid>
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,3,0"><TextBlock Text="CONFIG REGEX EDITS" Style="{StaticResource LabelTextStyle}"/><DataGrid ItemsSource="{Binding DataContext.ResolutionConfigEdits, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedResolutionConfigEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="105"><DataGrid.Columns><DataGridTextColumn Header="Pattern" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Replacement" Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add edit" Command="{Binding DataContext.AddResolutionConfigEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Remove" Command="{Binding DataContext.RemoveResolutionConfigEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="5,0,0,0"/></StackPanel></StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0"><TextBlock Text="SELECTED CONFIG EDIT MAP" Style="{StaticResource LabelTextStyle}"/><DataGrid ItemsSource="{Binding DataContext.ResolutionConfigEditMap, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedResolutionConfigEditMapRow, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="105"><DataGrid.Columns><DataGridTextColumn Header="Friendly" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Raw" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add map" Command="{Binding DataContext.AddResolutionConfigEditMapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Remove" Command="{Binding DataContext.RemoveResolutionConfigEditMapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="5,0,0,0"/></StackPanel></StackPanel>
                            </Grid>
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,3,0"><TextBlock Text="REGISTRY VALUE EDITS" Style="{StaticResource LabelTextStyle}"/><DataGrid ItemsSource="{Binding DataContext.ResolutionRegistryEdits, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedResolutionRegistryEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="95"><DataGrid.Columns><DataGridTextColumn Header="Value name" Binding="{Binding ValueName, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Kind" Binding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" Width="90"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add value" Command="{Binding DataContext.AddResolutionRegistryEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Remove" Command="{Binding DataContext.RemoveResolutionRegistryEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="5,0,0,0"/></StackPanel></StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0"><TextBlock Text="SELECTED REGISTRY VALUE MAP" Style="{StaticResource LabelTextStyle}"/><DataGrid ItemsSource="{Binding DataContext.ResolutionRegistryEditMap, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedResolutionRegistryEditMapRow, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="95"><DataGrid.Columns><DataGridTextColumn Header="Resolution" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Raw" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add map" Command="{Binding DataContext.AddResolutionRegistryEditMapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Remove" Command="{Binding DataContext.RemoveResolutionRegistryEditMapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="5,0,0,0"/></StackPanel></StackPanel>
                            </Grid>
                        </StackPanel></Border>
                        <TextBlock Text="RESOLUTIONS" Style="{StaticResource LabelTextStyle}" Margin="0,14,0,4"/><DockPanel><StackPanel DockPanel.Dock="Right" Width="170"><TextBox Text="{Binding DataContext.NewResolution, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Add" Command="{Binding DataContext.AddResolutionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4,0,0"/><Button Content="Remove" Command="{Binding DataContext.RemoveResolutionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4,0,0"/></StackPanel><ListBox ItemsSource="{Binding DataContext.Resolutions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedResolution, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="70"/></DockPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource LabelTextStyle}" Margin="0,14,0,4"/><DataGrid ItemsSource="{Binding Profile.Settings}" SelectedItem="{Binding DataContext.SelectedSetting, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="130"><DataGrid.Columns><DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Default" Binding="{Binding Default}" Width="*"/><DataGridTextColumn Header="Method" Binding="{Binding Apply.Method}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add setting" Command="{Binding DataContext.AddSettingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4,6,0"/><Button Content="Remove setting" Command="{Binding DataContext.RemoveSettingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4,0,0"/></StackPanel>
                        <Border Background="{StaticResource SurfaceAltBrush}" Padding="10" Margin="0,6,0,0" DataContext="{Binding DataContext.SelectedSetting, RelativeSource={RelativeSource AncestorType=UserControl}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Config path" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Apply.ConfigFilePath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="Registry key" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Apply.RegistryKey, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="1" Text="Menu path" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Apply.MenuPath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Verify pattern" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Apply.VerifyPattern, UpdateSourceTrigger=PropertyChanged}"/></Grid></Border>
                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceAltBrush}" Padding="10" Margin="0,0,3,0"><StackPanel><TextBlock Text="ALLOWED OPTIONS" Style="{StaticResource LabelTextStyle}"/><DockPanel Margin="0,4,0,0"><Button Content="Add" DockPanel.Dock="Right" Command="{Binding DataContext.AddSettingOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><TextBox Text="{Binding DataContext.NewSettingOption, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><ListBox ItemsSource="{Binding DataContext.SettingOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="75"/><Button Content="Remove last" Command="{Binding DataContext.RemoveSettingOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Left"/></StackPanel></Border>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" Padding="10" Margin="3,0,0,0"><StackPanel><TextBlock Text="FRIENDLY → RAW VALUE MAP" Style="{StaticResource LabelTextStyle}"/><DataGrid ItemsSource="{Binding DataContext.SettingValueMap, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedSettingMapRow, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="92"><DataGrid.Columns><DataGridTextColumn Header="Friendly" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Raw" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add map row" Command="{Binding DataContext.AddSettingMapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Remove" Command="{Binding DataContext.RemoveSettingMapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="6,0,0,0"/></StackPanel></StackPanel></Border>
                        </Grid>
                        <Border Background="{StaticResource SurfaceAltBrush}" Padding="10" Margin="0,6,0,0"><StackPanel>
                            <TextBlock Text="SETTING APPLY OPERATIONS" Style="{StaticResource LabelTextStyle}"/>
                            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,3,0"><TextBlock Text="CONFIG REGEX EDITS" Style="{StaticResource LabelTextStyle}"/><DataGrid ItemsSource="{Binding DataContext.SettingConfigEdits, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedSettingConfigEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="105"><DataGrid.Columns><DataGridTextColumn Header="Pattern" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Replacement" Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add edit" Command="{Binding DataContext.AddSettingConfigEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Remove" Command="{Binding DataContext.RemoveSettingConfigEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="5,0,0,0"/></StackPanel></StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0"><TextBlock Text="SELECTED CONFIG EDIT MAP" Style="{StaticResource LabelTextStyle}"/><DataGrid ItemsSource="{Binding DataContext.SettingConfigEditMap, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedSettingConfigEditMapRow, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="105"><DataGrid.Columns><DataGridTextColumn Header="Friendly" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Raw" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add map" Command="{Binding DataContext.AddSettingConfigEditMapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Remove" Command="{Binding DataContext.RemoveSettingConfigEditMapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="5,0,0,0"/></StackPanel></StackPanel>
                            </Grid>
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,3,0"><TextBlock Text="REGISTRY VALUE EDITS" Style="{StaticResource LabelTextStyle}"/><DataGrid ItemsSource="{Binding DataContext.SettingRegistryEdits, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedSettingRegistryEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="95"><DataGrid.Columns><DataGridTextColumn Header="Value name" Binding="{Binding ValueName, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Kind" Binding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" Width="90"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add value" Command="{Binding DataContext.AddSettingRegistryEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Remove" Command="{Binding DataContext.RemoveSettingRegistryEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="5,0,0,0"/></StackPanel></StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0"><TextBlock Text="SELECTED REGISTRY VALUE MAP" Style="{StaticResource LabelTextStyle}"/><DataGrid ItemsSource="{Binding DataContext.SettingRegistryEditMap, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedSettingRegistryEditMapRow, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="95"><DataGrid.Columns><DataGridTextColumn Header="Friendly" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Raw" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add map" Command="{Binding DataContext.AddSettingRegistryEditMapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Remove" Command="{Binding DataContext.RemoveSettingRegistryEditMapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="5,0,0,0"/></StackPanel></StackPanel>
                            </Grid>
                        </StackPanel></Border>
                        <TextBlock Text="VARIANTS" Style="{StaticResource LabelTextStyle}" Margin="0,14,0,4"/><DataGrid ItemsSource="{Binding Profile.Variants}" SelectedItem="{Binding DataContext.SelectedVariant, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="120"><DataGrid.Columns><DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80"/><DataGridCheckBoxColumn Header="Benchmark" Binding="{Binding BenchmarkEligible}" Width="90"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add variant" Command="{Binding DataContext.AddVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4,6,0"/><Button Content="Remove variant" Command="{Binding DataContext.RemoveVariantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4,0,0"/></StackPanel>
                        <Border Background="{StaticResource SurfaceAltBrush}" Padding="10" Margin="0,6,0,0" DataContext="{Binding DataContext.SelectedVariant, RelativeSource={RelativeSource AncestorType=UserControl}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Graphics preset" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding GraphicsPreset, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="Notes" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/></Grid></Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" Padding="10" Margin="0,6,0,0"><StackPanel><TextBlock Text="VARIANT SETTING OVERRIDES" Style="{StaticResource LabelTextStyle}"/><DataGrid ItemsSource="{Binding DataContext.VariantOverrides, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataContext.SelectedVariantOverride, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False" CanUserAddRows="False" Height="105"><DataGrid.Columns><DataGridTextColumn Header="Setting key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal"><Button Content="Add override" Command="{Binding DataContext.AddVariantOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/><Button Content="Remove" Command="{Binding DataContext.RemoveVariantOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="6,0,0,0"/></StackPanel></StackPanel></Border>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Clean modern dark palette (Fluent-ish, neutral, one accent).
         Status colors mirror the CLI's plan output
         (Ready=green / NotInstalled=amber / Invalid=red / Disabled=gray).
         ============================================================ -->

    <!-- Surfaces -->
    <Color x:Key="TitleBarColor">#0F1115</Color>
    <Color x:Key="NavBackgroundColor">#15171C</Color>
    <Color x:Key="AppBackgroundColor">#181B21</Color>
    <Color x:Key="SurfaceColor">#1F232B</Color>
    <Color x:Key="SurfaceAltColor">#272C36</Color>
    <Color x:Key="SurfaceHoverColor">#2D3340</Color>
    <Color x:Key="BorderColor">#2E343F</Color>
    <Color x:Key="BorderStrongColor">#3A4150</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#4C8DFF</Color>
    <Color x:Key="AccentHoverColor">#5E99FF</Color>
    <Color x:Key="AccentPressedColor">#3B73D6</Color>
    <Color x:Key="AccentSoftColor">#23344F</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#E7E9EE</Color>
    <Color x:Key="TextSecondaryColor">#A9B0BD</Color>
    <Color x:Key="TextMutedColor">#6C7585</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <!-- Status -->
    <Color x:Key="StatusReadyColor">#3FB950</Color>
    <Color x:Key="StatusNotInstalledColor">#D9A23B</Color>
    <Color x:Key="StatusInvalidColor">#E5534B</Color>
    <Color x:Key="StatusDisabledColor">#6C7585</Color>
    <Color x:Key="StatusInstalledColor">#4C8DFF</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="TitleBarBrush"        Color="{StaticResource TitleBarColor}"/>
    <SolidColorBrush x:Key="NavBackgroundBrush"   Color="{StaticResource NavBackgroundColor}"/>
    <SolidColorBrush x:Key="AppBackgroundBrush"   Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"         Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"      Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"    Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush"          Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush"    Color="{StaticResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="AccentBrush"          Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"     Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush"   Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush"      Color="{StaticResource AccentSoftColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"       Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush"    Color="{StaticResource TextOnAccentColor}"/>

    <SolidColorBrush x:Key="StatusReadyBrush"        Color="{StaticResource StatusReadyColor}"/>
    <SolidColorBrush x:Key="StatusNotInstalledBrush" Color="{StaticResource StatusNotInstalledColor}"/>
    <SolidColorBrush x:Key="StatusInvalidBrush"      Color="{StaticResource StatusInvalidColor}"/>
    <SolidColorBrush x:Key="StatusDisabledBrush"     Color="{StaticResource StatusDisabledColor}"/>
    <SolidColorBrush x:Key="StatusInstalledBrush"    Color="{StaticResource StatusInstalledColor}"/>

</ResourceDictionary>
